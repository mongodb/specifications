{
    "description": "operation write concern error",
    "schemaVersion": "1.27",
    "createEntities": [
        {
            "client": {
                "id": "client0",
                "useMultipleMongoses": false,
                "observeEvents": [
                    "commandStartedEvent",
                    "commandSucceededEvent",
                    "commandFailedEvent"
                ],
                "observeTracingMessages": {
                    "enableCommandPayload": false
                }
            }
        },
        {
            "client": {
                "id": "client1",
                "useMultipleMongoses": false,
                "uriOptions": {
                    "retryWrites": false
                },
                "observeTracingMessages": {
                    "enableCommandPayload": false
                }
            }
        },
        {
            "client": {
                "id": "failPointClient",
                "useMultipleMongoses": false
            }
        },
        {
            "database": {
                "id": "database0",
                "client": "client0",
                "databaseName": "operation-write-concern-error"
