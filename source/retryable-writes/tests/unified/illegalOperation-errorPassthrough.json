{
  "description": "retryable-writes IllegalOperation error passthrough",
  "schemaVersion": "1.3",
  "runOnRequirements": [
    {
      "topologies": [
        "single",
        "replicaset",
        "sharded",
        "load-balanced"
      ]
    }
  ],
  "createEntities": [
    {
      "client": {
        "id": "client0",
        "useMultipleMongoses": false
      }
    },
    {
      "database": {
        "id": "database0",
        "client": "client0",
        "databaseName": "retryable-writes-tests"
      }
    },
    {
      "collection": {
        "id": "collection0",
        "database": "database0",
        "collectionName": "coll"
      }
    },
    {
      "client": {
        "id": "clientRetryWritesFalse",
        "uriOptions": {
          "retryWrites": false
        },
        "useMultipleMongoses": false
      }
    },
    {
      "database": {
        "id": "databaseRetryWritesFalse",
        "client": "clientRetryWritesFalse",
        "databaseName": "retryable-writes-tests"
      }
    },
    {
      "collection": {
        "id": "collectionRetryWritesFalse",
        "database": "databaseRetryWritesFalse",
        "collectionName": "coll"
      }
    }
  ],
  "initialData": [
    {
      "collectionName": "coll",
      "databaseName": "retryable-writes-tests",
      "documents": []
    }
  ],
  "tests": [
    {
      "description": "InsertOne preserves an unrelated IllegalOperation error",
      "operations": [
        {
          "name": "failPoint",
          "object": "testRunner",
          "arguments": {
            "client": "client0",
            "failPoint": {
              "configureFailPoint": "failCommand",
              "mode": {
                "times": 1
              },
              "data": {
                "failCommands": [
                  "insert"
                ],
                "errorCode": 20
              }
            }
          }
        },
        {
          "name": "insertOne",
          "object": "collection0",
          "arguments": {
            "document": {
              "_id": 1
            }
          },
          "expectError": {
            "errorCode": 20,
            "errorCodeName": "IllegalOperation",
            "errorContains": "'failCommand' failpoint",
            "errorLabelsOmit": [
              "RetryableWriteError"
            ]
          }
        }
      ]
    },
    {
      "description": "InsertOne preserves an unrelated IllegalOperation error when retryWrites is false",
      "operations": [
        {
          "name": "failPoint",
          "object": "testRunner",
          "arguments": {
            "client": "clientRetryWritesFalse",
            "failPoint": {
              "configureFailPoint": "failCommand",
              "mode": {
                "times": 1
              },
              "data": {
                "failCommands": [
                  "insert"
                ],
                "errorCode": 20
              }
            }
          }
        },
        {
          "name": "insertOne",
          "object": "collectionRetryWritesFalse",
          "arguments": {
            "document": {
              "_id": 1
            }
          },
          "expectError": {
            "errorCode": 20,
            "errorCodeName": "IllegalOperation",
            "errorContains": "'failCommand' failpoint",
            "errorLabelsOmit": [
              "RetryableWriteError"
            ]
          }
        }
      ]
    },
    {
      "description": "ClientBulkWrite preserves an unrelated IllegalOperation error",
      "runOnRequirements": [
        {
          "minServerVersion": "8.0"
        }
      ],
      "operations": [
        {
          "name": "failPoint",
          "object": "testRunner",
          "arguments": {
            "client": "client0",
            "failPoint": {
              "configureFailPoint": "failCommand",
              "mode": {
                "times": 1
              },
              "data": {
                "failCommands": [
                  "bulkWrite"
                ],
                "errorCode": 20
              }
            }
          }
        },
        {
          "name": "clientBulkWrite",
          "object": "client0",
          "arguments": {
            "models": [
              {
                "insertOne": {
                  "namespace": "retryable-writes-tests.coll",
                  "document": {
                    "_id": 1
                  }
                }
              }
            ]
          },
          "expectError": {
            "errorCode": 20,
            "errorCodeName": "IllegalOperation",
            "errorContains": "'failCommand' failpoint",
            "errorLabelsOmit": [
              "RetryableWriteError"
            ]
          }
        }
      ]
    },
    {
      "description": "InsertOne replaces the message of a transaction numbers IllegalOperation error",
      "runOnRequirements": [
        {
          "minServerVersion": "8.3",
          "topologies": [
            "replicaset",
            "sharded",
            "load-balanced"
          ]
        }
      ],
      "operations": [
        {
          "name": "failPoint",
          "object": "testRunner",
          "arguments": {
            "client": "client0",
            "failPoint": {
              "configureFailPoint": "failCommand",
              "mode": {
                "times": 1
              },
              "data": {
                "failCommands": [
                  "insert"
                ],
                "errorCode": 20,
                "errorMsg": "Transaction numbers are only allowed on storage engines that support document-level locking"
              }
            }
          }
        },
        {
          "name": "insertOne",
          "object": "collection0",
          "arguments": {
            "document": {
              "_id": 1
            }
          },
          "expectError": {
            "errorContains": "This MongoDB deployment does not support retryable writes. Please add retryWrites=false to your connection string."
          }
        }
      ]
    }
  ]
}
